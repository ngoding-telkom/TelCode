# .env.local

# Supabase — ambil dari dashboard project > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...        # aman untuk client
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...            # JANGAN pernah di client

# Judge0 — self-hosted di VPS terpisah
# JUDGE0_API_URL=https://judge0.yourdomain.com
# JUDGE0_API_KEY=xxxxx     
# # kalau kamu setel auth di Judge0-nya
# Endpoint compile Wandbox, misalnya https://wandbox.org/api/compile.json
WANDBOX_COMPILE_URL=https://wandbox.org/api/compile.json

# Callback URL — dipakai Judge0 untuk POST balik hasil
# saat lokal, pakai ngrok/tunnel karena Judge0 di VPS tidak bisa akses localhost kamu
NEXT_PUBLIC_APP_URL=http://localhost:3000
